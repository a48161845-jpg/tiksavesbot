# ===== Обязательное =====
BOT_TOKEN=123456:replace-me
# DATABASE_URL=postgresql://user:pass@host:5432/db   # без неё данные хранятся в data.json

# ===== Локальный Bot API (файлы до 2 ГБ) — необязательно =====
# API_ID=
# API_HASH=
# LOCAL_BOT_API_URL=http://127.0.0.1:8081
# LOCAL_BOT_API_PORT=8081

# ===== Каналы логов =====
# LOG_CHANNEL_ID=-100...
# INLINE_CACHE_CHANNEL_ID=-100...

# ===== Доноры =====
# DONATIONALERTS_URL=
# OZON_DONATE_URL=            # ссылка на оплату по СБП (любой банк), вкладка «Донат рублями (для РФ)»
# NUDGE_EVERY=2               # напоминание о донате после каждого N-го скачивания

# ===== Premium (Telegram Stars) =====
# PREMIUM_STARS_30=150
# PREMIUM_STARS_90=400
# PREMIUM_STARS_365=1200
# PREMIUM_LIMIT_MULT=3        # во сколько раз Premium увеличивает лимиты

# ===== Группы =====
# GROUP_AUTO_LINKS=1          # 0 — в группах не реагировать на ссылки

# ===== Скачивание =====
# YTDLP_PROXY=                # http://user:pass@host:port — при блоке IP (TikTok/Instagram/Pinterest) и 429
# YTDLP_COOKIES_FILE=cookies.txt
# YTDLP_COOKIES_B64=          # cookies.txt в base64 (для хостингов без файлов)
# YTDLP_POT_URL=              # PO-token провайдер для YouTube
# YTDLP_AUTOUPDATE=1
# INSTAGRAM_MIRRORS=https://www.ddinstagram.com,https://kkinstagram.com
# COBALT_API_URL=
# COBALT_API_KEY=
# MAX_VIDEO_MB=
# YOUTUBE_MAX_DURATION_SEC=
# COMPRESS_OVER_LIMIT=1

# ===== Inline-режим =====
# INLINE_PHOTO_LIMIT=10       # сколько кадров фото-поста показывать в inline (1–50)
# INLINE_TIMEOUT_SEC=7

# TIKTOK_PAGE_ACCEPT_LANGUAGE=   # пусто = не навязывать язык (TikTok отдаёт оригинал); иначе, напр., ru-RU,ru;q=0.9

# ===== Лимиты =====
# GLOBAL_CONCURRENCY=12
# SPAM_COOLDOWN_SEC=15
# DL_MAX_ACTIONS=25
# DL_WINDOW_SEC=60
# PHOTO_LIMIT_PER_MIN=400
